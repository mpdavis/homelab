# Managed by Ansible (roles/devbox) — edits here are overwritten.
#
# Read alongside Tailscale SSH, which is also enabled on this host: tailscaled
# terminates tailnet SSH itself and authorises against the tailnet ACL, never
# reaching this daemon. These settings govern key-based logins over the LAN and
# the tailnet IP, which is the path herdr and Ansible use.

PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password

AllowUsers {{ devbox_ssh_allow_users | join(' ') }}

# Long-lived agent panes go quiet for hours. Without server-side keepalives the
# NAT state between here and a laptop or phone expires and the session dies
# mid-task; herdr survives that (the server keeps running) but reattaching is
# friction worth avoiding.
ClientAliveInterval {{ devbox_ssh_alive_interval }}
ClientAliveCountMax {{ devbox_ssh_alive_count_max }}
TCPKeepAlive yes

# Terminal capability and colour hints, so a pane opened from a phone renders
# the same as one from the laptop.
AcceptEnv LANG LC_* TERM COLORTERM
