# Managed by Ansible (roles/devbox) — edits here are overwritten.
# Mode 0600. Sourced by /etc/profile.d/devbox.sh.
{% if devbox_claude_oauth_token | default('') | length > 0 %}
# Long-lived Claude subscription OAuth token from `claude setup-token`
# (~1 year expiry). Re-run the playbook with a fresh token to rotate.
export CLAUDE_CODE_OAUTH_TOKEN={{ devbox_claude_oauth_token }}
{% endif %}
