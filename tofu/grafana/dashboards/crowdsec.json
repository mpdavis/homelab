    {
      "id": 15,
      "type": "table",
      "title": "Top source IPs",
      "description": "Alerts per source IP over the dashboard range, local and WAF.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(15, sum by (source_ip, country, asn) (count_over_time({stack=\"proxy\", service=\"crowdsec\"} | logfmt | msg=~\".* by (ip|range) .*\" | line_format \"{{.msg}}\" | regexp `^\\((?P<machine>[^)]*)\\) (?:alert : )?(?P<scenario>\\S+)(?: for \\d+/\\d+ decisions)? by (?:ip|range) (?P<source_ip>\\S+)(?: \\((?P<country>[^/)]*)/?(?P<asn>[^)]*)\\))?(?: : (?P<duration>\\S+) (?P<action>\\S+) on .*)?$` [$__range])))",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source_ip": "IP",
              "country": "Country",
              "asn": "ASN"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Count"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
