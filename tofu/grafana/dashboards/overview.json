{
  "uid": "homelab-overview",
  "title": "Homelab overview",
  "tags": [
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "description": "Is everything working: synthetic checks, alerts, hosts, stacks and deploys. Built in tofu/grafana; edit the JSON there, not in the UI.",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Status page",
      "type": "link",
      "url": "https://status.mpdavis.com",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "CrowdSec",
      "type": "link",
      "url": "/d/crowdsec",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Hosts reporting",
      "description": "Docker hosts (apps, infra) whose Alloy agent is shipping node metrics. Fewer than 2 means a host or its monitoring is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "count(up{job=\"node\"} == 1) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 1
    },
    {
