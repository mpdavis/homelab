        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "count(sum by (host, deployment) (increase(doco_cd_deployment_errors_total[15m])) > 0) or vector(0)",
          "instant": true,
          "range": false
