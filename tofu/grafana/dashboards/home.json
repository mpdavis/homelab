    {
      "type": "stat",
      "title": "Internet",
      "description": "Share of Grafana Cloud probes that reached status.mpdavis.com in the last 6 minutes: the WAN, router and public Caddy.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "avg(avg_over_time(probe_success{job=\"public-ingress\"}[6m]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
