# Tailnet-only sites; the public ones live in Caddyfile.public. See
# docs/compose.md.
{
	email michael@mpdavis.com
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Defines (authentik). Shared with Caddyfile.public.
import /etc/caddy/authentik.caddy

home.mpdavis.com {
	reverse_proxy homepage:3000
}

podfetch.mpdavis.com {
	reverse_proxy podfetch:8000
}

gridiron.mpdavis.com {
	route {
		import authentik
		reverse_proxy gridiron:8080
	}
}

# The version API is unauthenticated; served ahead of auth for Gatus, like
# /ping on prowlarr below.
dispatcharr.mpdavis.com {
	route {
		reverse_proxy /api/core/version/ dispatcharr:9191
		import authentik
		reverse_proxy dispatcharr:9191
	}
}

teamarr.mpdavis.com {
	route {
		import authentik
		reverse_proxy teamarr:9195
	}
}

# No forward auth: ECM has its own login, and MCP clients authenticate with a
# bearer key they could not get past Authentik with.
ecm.mpdavis.com {
	handle /mcp* {
		reverse_proxy ecm-mcp:6101
	}
	handle {
		reverse_proxy ecm:6100
	}
}

qbit.mpdavis.com {
	route {
		import authentik
		reverse_proxy qbittorrent:8080
	}
}

# No forward auth, as before: mousehole has its own password.
mousehole.mpdavis.com {
	reverse_proxy mousehole:5010
}

# /ping is unauthenticated upstream and answers only "OK". Serving it ahead of
# the auth check lets Gatus test the app itself, which the Authentik redirect
# on every other path cannot.
prowlarr.mpdavis.com {
	route {
		reverse_proxy /ping prowlarr:9696
		import authentik
		reverse_proxy prowlarr:9696
	}
}

sonarr.mpdavis.com {
	route {
		reverse_proxy /ping sonarr:8989
		import authentik
		reverse_proxy sonarr:8989
	}
}

radarr.mpdavis.com {
	route {
		reverse_proxy /ping radarr:7878
		import authentik
		reverse_proxy radarr:7878
	}
}

listenarr.mpdavis.com {
	route {
		import authentik
		reverse_proxy listenarr:4545
	}
}

# No forward auth: Paperless signs users in through Authentik itself (OIDC), and
# its API clients use tokens they could not get past forward auth with.
paperless.mpdavis.com {
	reverse_proxy paperless:8000
}

# No forward auth: QuantDinger has its own login, with registration disabled.
trading.mpdavis.com {
	reverse_proxy quantdinger:80
}

# /health ahead of auth for Gatus, like /ping on prowlarr.
ai.mpdavis.com {
	route {
		reverse_proxy /health open-webui:8080
		import authentik
		reverse_proxy open-webui:8080
	}
}
