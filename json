apiVersion: v1
data:
  default.conf: |
    server {
        listen 8080;
        server_name _;
        charset utf-8;

        root /srv/digests;
        # index.html is regenerated by the digest job on every run, so there is
        # no need for autoindex — and leaving it off means a missing index
        # reads as a clear 404 rather than a bare file listing.
        index index.html;

        location / {
            try_files $uri $uri/ =404;
        }

        # Serve the Markdown alongside each digest as text the browser renders
        # inline; nginx's default type for .md prompts a download instead.
        location ~ \.md$ {
            default_type text/plain;
            charset utf-8;
        }

        # Unauthenticated liveness endpoint for the kubelet probes. Traefik's
        # forward-auth sits in front of the route, so this is only reachable
        # from inside the cluster.
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }
    }
