apiVersion: apps/v1
kind: Deployment
metadata:
  name: emby
  namespace: media
spec:
  replicas: 1
  selector:
    matchLabels:
      app: emby
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: emby
    spec:
      containers:
      - env:
        - name: TZ
          value: ${TZ}
        - name: NVIDIA_VISIBLE_DEVICES
          value: all
        - name: NVIDIA_DRIVER_CAPABILITIES
          value: all
        image: emby/embyserver:4.10.0.22
        name: emby
        ports:
        - containerPort: 8096
          name: http
        resources:
          limits:
            nvidia.com/gpu: "1"
        volumeMounts:
        - mountPath: /config
          name: config
        - mountPath: /media
          name: media
      - command:
        - /bin/sh
        - -c
        - |
          set -eu
          LOGDIR=/config/logs
          tailed=""
          while true; do
            for f in "$LOGDIR"/*.txt; do
              [ -e "$f" ] || continue
              case " $tailed " in
                *" $f "*) ;;
                *)
                  tailed="$tailed $f"
                  # ffmpeg transcode logs are one-shot and deleted when
                  # the session ends; follow by descriptor (-f) so the
                  # tail goes idle instead of spamming reopen-retry
                  # errors. Persistent server/hardware logs rotate by
                  # name, so follow by name (-F).
                  if echo "$f" | grep -q "ffmpeg-transcode"; then
                    ( tail -n 0 -f "$f" | sed "s|^|[$(basename "$f")] |" ) &
                  else
                    ( tail -n 0 -F "$f" | sed "s|^|[$(basename "$f")] |" ) &
                  fi
                  ;;
              esac
            done
            sleep 15
          done
        image: busybox:1.38.0
        name: log-shipper
        resources:
          limits:
            memory: 64Mi
          requests:
            cpu: 10m
            memory: 16Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 1000
        volumeMounts:
        - mountPath: /config
          name: config
          readOnly: true
      runtimeClassName: nvidia
      volumes:
      - name: config
        persistentVolumeClaim:
          claimName: emby-config
      - name: media
        nfs:
          path: ${NAS_DATA_PATH}/media
          server: ${NAS_IP}
